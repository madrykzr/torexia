# Sanity — required for the site to read content at build & runtime.
# Copy to .env.local for local dev, and set the same vars in your host
# (e.g. Vercel → Settings → Environment Variables) for deploys.

# Public (safe to expose — shipped to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID="oh5pjj5g"
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional — defaults to a recent date in sanity/env.ts if omitted
# NEXT_PUBLIC_SANITY_API_VERSION="2026-07-04"

# Server-only secret. Needed because the dataset is PRIVATE.
# Create at https://www.sanity.io/manage → project → API → Tokens.
#  - Viewer/read token for the website (recommended)
#  - Editor/write token if you also run `npm run seed`
# Alternatively, make the dataset public and omit this entirely.
SANITY_API_READ_TOKEN=""
# SANITY_API_WRITE_TOKEN=""   # only needed to run the seed script
